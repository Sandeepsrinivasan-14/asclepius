# Backend (all optional; sensible demo defaults)
ASCLEPIUS_SECRET=change-me-in-any-shared-environment
ASCLEPIUS_DB=:memory:          # or a file path such as ./asclepius.db
ASCLEPIUS_SEED=2026
ASCLEPIUS_PATIENTS=64
ASCLEPIUS_DEMO_AUTH=true       # persona sign-in. Set false to disable.
ASCLEPIUS_BTG_MINUTES=60
ASCLEPIUS_CORS=http://localhost:3000
# Optional: local OpenAI-compatible LLM (e.g. Ollama) for narrative wording. The verifier still gates every output.
ASCLEPIUS_LLM_URL=
ASCLEPIUS_LLM_MODEL=llama3.1

# Frontend
ASCLEPIUS_API_URL=http://127.0.0.1:8000
